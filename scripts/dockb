#!/usr/bin/env bash

# Default compose file
COMPOSE_FILE="docker-compose-commandbox.yml"
CONTAINER_NAME=""

# Parse command line arguments
while [[ $# -gt 0 ]]; do
    case $1 in
        -f|--file)
            COMPOSE_FILE="$2"
            shift 2
            ;;
        *)
            if [[ -z "$CONTAINER_NAME" ]]; then
                CONTAINER_NAME="$1"
            else
                echo "Error: Multiple container names provided. Only one container name is allowed."
                exit 1
            fi
            shift
            ;;
    esac
done

# Check if container name is provided
if [[ -z "$CONTAINER_NAME" ]]; then
    echo "Error: Container name is required."
    echo "Usage: $0 [-f|--file COMPOSE_FILE] CONTAINER_NAME"
    echo "  -f, --file    Docker compose file (default: docker-compose-commandbox.yml)"
    echo "  CONTAINER_NAME  Name of the container to build and start (required)"
    exit 1
fi

# Execute docker compose command
echo "Building and starting container '$CONTAINER_NAME' using compose file '$COMPOSE_FILE'..."
docker compose -f "$COMPOSE_FILE" up "$CONTAINER_NAME" --build


